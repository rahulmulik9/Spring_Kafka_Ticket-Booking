    {
      "name": "06 Steps 6-7 - Booking",
      "item": [
        {
          "name": "Book A and B (DB lock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{showId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "{{showId}}"
              ]
            },
            "description": "Needs a hold first, otherwise 409 SEAT_NOT_HELD. Holds are removed after the booking.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seatIds\": [{{seatA}}, {{seatB}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"bookingId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Book A (Redis lock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{showId}}/redis-lock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "{{showId}}",
                "redis-lock"
              ]
            },
            "description": "Step 7 comparison endpoint. Run it on two app copies (ports 8080 and 8081) to see SEAT_BUSY.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seatIds\": [{{seatA}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            }
