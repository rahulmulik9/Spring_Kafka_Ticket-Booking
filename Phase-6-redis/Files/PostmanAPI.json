    {
      "name": "02 Step 8 - Login rate limit",
      "item": [
        {
          "name": "Wrong password (send 6 times)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Attempts 1 to 5 return 401. Attempt 6 returns 429 with a Retry-After header. Even the correct password is refused until the window ends.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@test.com\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "03 Steps 2-4 - Movie cache",
      "item": [
        {
          "name": "Movie summary page (cached)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/summary?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "summary"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "First call = cache miss, next calls = hits. Key in Redis: movieSummaryPage::0-20-id: ASC",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Movie by id (cached)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "1"
              ]
            },
            "description": "Key in Redis: movieById::1",
