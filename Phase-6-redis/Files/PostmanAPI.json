    {
      "name": "05 Step 5 - Seat hold",
      "item": [
        {
          "name": "Alice holds A and B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/holds/{{showId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "holds",
                "{{showId}}"
              ]
            },
            "description": "Redis keys: hold:seat:<id>. TTL is 30 s in dev.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seatIds\": [{{seatA}}, {{seatB}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Bob holds C and B (409 SEAT_ALREADY_HELD)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/holds/{{showId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "holds",
                "{{showId}}"
              ]
            },
            "description": "Seat C must NOT stay held (all-or-nothing).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seatIds\": [{{seatC}}, {{seatB}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bobToken}}",
                  "type": "string"
                }
