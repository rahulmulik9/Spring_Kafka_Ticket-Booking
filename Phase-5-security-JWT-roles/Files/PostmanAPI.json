              "raw": "{\n  \"seatIds\": [\n    \"{{seatId1}}\",\n    \"{{seatId2}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Name and email now come from the logged-in user's token, not the body. Log in first."
          },
          "event": [
