    {
      "name": "4. Seats",
      "item": [
        {
          "name": "Get Seats By Show (saves 2 free seat ids)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/shows/{{showId}}/seats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shows",
                "{{showId}}",
                "seats"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var seats = pm.response.json();",
                  "var free = seats.filter(function (s) { return s.status === 'AVAILABLE'; });",
                  "if (free.length >= 2) {",
                  "  pm.collectionVariables.set('seatId1', free[0].id);",
                  "  pm.collectionVariables.set('seatId2', free[1].id);",
                  "}",
                  "pm.test('Show has at least 2 free seats', function () { pm.expect(free.length).to.be.at.least(2); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
